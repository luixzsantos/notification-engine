# API
API_PORT=8080

# Redis (fila)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_NAME=notifications:stream
REDIS_CONSUMER_GROUP=notification-workers
REDIS_CONSUMER_NAME=worker-1
WORKER_CONCURRENCY=10

# PostgreSQL (persistência/auditoria)
DB_HOST=seu-host-do-banco
DB_PORT=sua-porta-do-banco
DB_USER=seu-usuario-do-banco
DB_PASSWORD=sua-senha-do-banco
DB_NAME=seu_banco_de_dados
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=false

# Gmail (SMTP)
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USERNAME=seu-email@gmail.com
GMAIL_APP_PASSWORD=sua-senha-de-app
GMAIL_FROM_NAME=

# Targets padrão (usados quando "target" não é enviado na requisição)
DEFAULT_DISCORD_TARGET=
DEFAULT_TELEGRAM_TARGET=
DEFAULT_EMAIL_TARGET=

# HTTP
HTTP_CLIENT_TIMEOUT_SECONDS=10

# Retry / DLQ
RETRY_MAX_ATTEMPTS=5
RETRY_MAX_BACKOFF_SECONDS=3600
RETRY_POLL_INTERVAL_SECONDS=10
RETRY_BATCH_SIZE=50

# Rate limiting (requisições por segundo, por canal)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DISCORD_RPS=10
RATE_LIMIT_TELEGRAM_RPS=20
RATE_LIMIT_WEBHOOK_RPS=50
RATE_LIMIT_EMAIL_RPS=5

# Métricas Prometheus
METRICS_ENABLED=true
METRICS_PORT=9091

# Segurança: API Key (protege POST/GET de /api/v1/*; vazio = sem autenticação, só para dev local)
API_KEY=

# Segurança: CORS (origens separadas por vírgula; "*" libera qualquer origem)
CORS_ALLOWED_ORIGINS=*

# Segurança: chat_ids do Telegram autorizados a usar /retry e /status no bot (separados por vírgula; vazio = qualquer chat)
TELEGRAM_ALLOWED_CHAT_IDS=

# Segurança: desliga a proteção contra SSRF em webhook/discord (NUNCA true em produção; só para testar contra serviços internos em dev)
ALLOW_PRIVATE_NETWORK_TARGETS=false
